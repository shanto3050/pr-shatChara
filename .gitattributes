# Unity serializes empty YAML values with a trailing space. Preserve its format.
*.asset text eol=lf whitespace=-blank-at-eol
*.meta text eol=lf whitespace=-blank-at-eol
*.unity text eol=lf whitespace=-blank-at-eol
*.mat text eol=lf whitespace=-blank-at-eol
*.wlt text eol=lf whitespace=-blank-at-eol
*.cs text eol=lf
*.asmdef text eol=lf
*.json text eol=lf
*.md text eol=lf
unity/SatChara/Assets/TutorialInfo/** whitespace=-blank-at-eol
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.prefab text eol=lf whitespace=-blank-at-eol
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.asf -text whitespace=-blank-at-eol,cr-at-eol
*.amc -text whitespace=-blank-at-eol,cr-at-eol
